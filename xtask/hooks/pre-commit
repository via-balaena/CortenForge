#!/bin/sh
# CortenForge Pre-Commit Hook
# Auto-installed by: xtask (build.rs on build, and `cargo xtask setup`)
#
# ⚠ SINGLE SOURCE OF TRUTH: xtask/hooks/ — edit THAT file, never a copy.
#   This text used to be duplicated as a const in BOTH xtask/build.rs and
#   xtask/src/setup.rs, kept in sync by a comment. It drifted: #709 added the
#   scan/mesh guard to the build.rs copy only, so `cargo xtask setup` installed
#   a hook without it — and build.rs then refused to overwrite that hook because
#   it did not carry build.rs's own sentinel. Both installers now read this file.
#
# This hook enforces quality standards before commits reach CI.
# See docs/INFRASTRUCTURE.md for the full constraint specification.
#
# Performance: only lints crates with staged changes (not the full workspace).

set -e

echo "╔═══════════════════════════════════════════════════════════════╗"
echo "║                  CortenForge Pre-Commit Check                  ║"
echo "╚═══════════════════════════════════════════════════════════════╝"

# ── Scan/mesh guard — FIRST, because it is a safety rule, not a quality one ──
# This repository is PUBLIC, and the casting pipeline's inputs are anatomical scans
# of a real person. They live outside the repo by design: reached via
# CF_CAST_ITER1_DIR (design/cf-cast/tests/iter1_gate.rs, #[ignore]d) or regenerated
# by cf-cast. Zero meshes have ever been tracked here — but that was habit, not a
# rule. Verified 2026-07-29: `git add` accepted a 29 MB anatomical scan without
# complaint, and once such a blob is pushed it is in the public history permanently.
#
# .gitignore now blocks these extensions; this check catches `git add -f`, which
# .gitignore cannot. Both layers, because the cost of one miss is unrecoverable.
#
# Escape hatch for a genuinely non-personal fixture mesh:
#     CF_ALLOW_MESH=1 git commit ...
echo "→ Checking for scan/mesh binaries..."
# ':(icase)' is load-bearing. Git pathspecs are CASE-SENSITIVE, so a bare '*.stl'
# does NOT match PART.STL — and scanners happily emit uppercase extensions. Without
# it the guard is bypassed by the filename alone, which is the hole it exists to close.
# ⚠ FAILS CLOSED. This used to end in `|| true`, so ANY git failure — an older git
# that rejects the ':(icase)' magic pathspec, a corrupt index, a GIT_INDEX_FILE
# problem — produced an empty list, printed "No scan/mesh binaries staged" and let
# the commit through with the scan attached. Note the clippy step below has no
# `|| true` and so aborts under `set -e`: the QUALITY check was failing safe while
# this one, whose miss is unrecoverable, was failing unsafe.
guard_unreadable=0
if ! staged_meshes=$(git diff --cached --name-only --diff-filter=ACMR \
    -- ':(icase)*.stl' ':(icase)*.obj' ':(icase)*.ply' \
       ':(icase)*.3mf' ':(icase)*.mtl'); then
    if [ "${CF_ALLOW_MESH:-0}" = "1" ]; then
        # The DOCUMENTED override has to work here too. Without it the only way past
        # a malfunctioning guard is `git commit --no-verify`, which ALSO disables the
        # commit-message check — so the mitigation for one broken gate silently drops
        # a second. Skipping loudly beats pushing people to the bigger hammer.
        echo "⚠ CF_ALLOW_MESH=1 — the staged file list could not be read, so the"
        echo "  scan/mesh guard was SKIPPED ENTIRELY for this commit."
        guard_unreadable=1
        staged_meshes=""
    else
        echo "✗ Could not read the staged file list, so the scan/mesh guard cannot run."
        echo "  Refusing the commit: an unreadable index is NOT evidence that nothing"
        echo "  is staged, and this guard protects a PUBLIC repo from anatomical data."
        echo ""
        echo "  If you must commit anyway:  CF_ALLOW_MESH=1 git commit ..."
        echo "  Prefer that to --no-verify, which also drops the commit message check."
        exit 1
    fi
fi
if [ "$guard_unreadable" = "1" ]; then
    # ⚠ Deliberately says NOTHING more. Falling through to the "✓ No scan/mesh
    # binaries staged" branch below would print a clean bill of health for a check
    # that never ran — the exact false statement this guard's history is made of.
    :
elif [ -n "$staged_meshes" ]; then
    if [ "${CF_ALLOW_MESH:-0}" = "1" ]; then
        # Say so LOUDLY. Printing "no meshes staged" here — which is what this used
        # to do — hides the one commit anyone would ever want a record of.
        echo "⚠ CF_ALLOW_MESH=1 — allowing mesh/scan binaries through:"
        echo "$staged_meshes" | sed 's/^/      /'
    else
        echo "✗ Refusing to commit mesh/scan binaries to a PUBLIC repository:"
        echo "$staged_meshes" | sed 's/^/      /'
        echo ""
        echo "  Scan inputs are anatomical and must stay outside this repo (~/scans)."
        echo "  Generated meshes are reproducible and have no browse value."
        echo "  If this really is a non-personal fixture:  CF_ALLOW_MESH=1 git commit ..."
        exit 1
    fi
else
    echo "✓ No scan/mesh binaries staged"
fi

# Format check (fast — only checks already-formatted files, <1s)
echo "→ Checking formatting..."
if ! cargo fmt --all -- --check 2>/dev/null; then
    echo "✗ Formatting check failed. Run: cargo fmt --all"
    exit 1
fi
echo "✓ Formatting OK"

# Determine which crates have staged Rust or Cargo.toml changes.
# Pathspec `'*Cargo.toml'` matches nested manifests (sim/L0/**/Cargo.toml,
# examples/**/Cargo.toml, etc.) as well as the workspace root. A plain
# `'Cargo.toml'` pathspec would only match the workspace root.
staged_rs_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs' '*Cargo.toml')

if [ -z "$staged_rs_files" ]; then
    echo "→ No Rust/Cargo files staged — skipping clippy."
else
    # Extract crate names from staged file paths.
    # Walk up from each file to find nearest Cargo.toml, read [package] name.
    crates=""
    for file in $staged_rs_files; do
        dir=$(dirname "$file")
        while [ "$dir" != "." ]; do
            if [ -f "$dir/Cargo.toml" ] && grep -q '^\[package\]' "$dir/Cargo.toml"; then
                name=$(sed -n '/^\[package\]/,/^\[/{s/^name *= *"\(.*\)"/\1/p;}' "$dir/Cargo.toml")
                if [ -n "$name" ]; then
                    crates="$crates $name"
                fi
                break
            fi
            dir=$(dirname "$dir")
        done
    done

    # Deduplicate
    crates=$(echo "$crates" | tr ' ' '\n' | sort -u | tr '\n' ' ' | sed 's/ *$//')

    if [ -z "$crates" ]; then
        echo "→ Staged Rust files don't belong to a workspace crate — skipping clippy."
    else
        echo "→ Running clippy on changed crates: $crates"
        clippy_args=""
        for crate in $crates; do
            clippy_args="$clippy_args -p $crate"
        done
        if ! cargo clippy $clippy_args --all-targets --all-features -- -D warnings 2>/dev/null; then
            echo "✗ Clippy check failed. Fix errors before committing."
            exit 1
        fi
        echo "✓ Clippy OK"
    fi
fi

# Note: unwrap/expect enforcement is handled by clippy via workspace lints
# (clippy::unwrap_used = "deny" in Cargo.toml)
# The grep-based scan was removed as it caught doc examples falsely.

echo ""
echo "╔═══════════════════════════════════════════════════════════════╗"
echo "║                    Pre-commit checks passed                    ║"
echo "╚═══════════════════════════════════════════════════════════════╝"
