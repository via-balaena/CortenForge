<mujoco model="pinned">
  <compiler angle="radian" fitaabb="true" autolimits="true">
    <lengthrange mode="all" useexisting="false" uselimit="true" inttotal="5" tolrange="0.1"/>
  </compiler>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4">
    <flag warmstart="disable"/>
  </option>
  <default>
    <geom friction="0.8 0.01 0.001" fitscale="1.5"/>
    <joint damping="0.1" armature="0.01"/>
    <default class="arm">
      <geom type="capsule" size="0.05 0.2" fitscale="0.9"/>
      <joint type="hinge" axis="0 1 0" range="-1 1"/>
      <motor gear="2" ctrlrange="-1 1"/>
      <site size="0.01"/>
    </default>
  </default>
  <asset>
    <mesh name="tet" content_type="model/stl" vertex="0 0 0  1 0 0  0 2 0  0 0 3" face="0 2 1  0 1 3  0 3 2  1 2 3" refpos="0 0 0.1"/>
    <hfield name="hf" size="1 1 0.1 0.05" nrow="2" ncol="2" elevation="0 0.5 1 0.25"/>
  </asset>
  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1"/>
    <geom name="ground" type="hfield" hfield="hf" pos="3 0 0"/>
    <camera name="watch" mode="targetbody" target="base" pos="2 2 2"/>
    <body name="base" pos="0 0 1" quat="1 0 0 0">
      <freejoint name="root" align="true"/>
      <geom name="fitted" type="box" mesh="tet" fitscale="2"/>
      <site name="s0" pos="0 0 0.1" size="0.02"/>
      <body name="arm" childclass="arm" pos="0 0 0.3">
        <joint name="shoulder"/>
        <inertial pos="0 0 0.1" mass="1" diaginertia="0.01 0.01 0.001"/>
        <geom name="upper" fromto="0 0 0 0 0 0.4" size="0.04"/>
        <site name="tip" pos="0 0 0.4"/>
        <light name="lamp" mode="targetbody" target="hand" pos="0 0 1"/>
        <frame pos="0 0 0.4" euler="0 0.3 0">
          <camera name="eye" target="arm" pos="0 0 0.2"/>
          <body name="hand" pos="0 0 0.1">
            <joint name="wrist" type="slide" axis="1 0 0"/>
            <geom name="palm" type="sphere" size="0.05"/>
          </body>
        </frame>
      </body>
    </body>
  </worldbody>
  <custom>
    <tuple name="pair">
      <element objtype="body" objname="hand"/>
      <element objtype="geom" objname="palm"/>
    </tuple>
  </custom>
  <contact>
    <pair geom1="floor" geom2="palm" condim="3"/>
    <exclude body1="base" body2="arm"/>
  </contact>
  <equality>
    <joint joint1="shoulder" joint2="wrist" polycoef="0 1 0 0 0"/>
    <weld body1="hand" body2="arm" anchor="0.1 0 0" relpose="0 0 0.1 1 0 0 0" torquescale="0.5"/>
    <weld site1="s0" site2="tip" active="false"/>
  </equality>
  <tendon>
    <fixed name="ft">
      <joint joint="shoulder" coef="1"/>
      <joint joint="wrist" coef="-0.5"/>
    </fixed>
    <spatial name="st" width="0.01">
      <site site="s0"/>
      <site site="tip"/>
    </spatial>
  </tendon>
  <actuator>
    <motor name="m0" joint="shoulder" class="arm"/>
    <position name="p0" joint="wrist" kp="10" ctrlrange="-0.5 0.5"/>
    <general name="g0" tendon="ft" gainprm="1" biasprm="0 0 -1"/>
  </actuator>
  <sensor>
    <jointpos joint="shoulder"/>
    <framepos objtype="site" objname="tip"/>
    <touch site="s0"/>
    <tendonpos tendon="st"/>
  </sensor>
  <keyframe>
    <key name="home" qpos="0 0 1 1 0 0 0 0.1 0"/>
  </keyframe>
</mujoco>
