                      diaginertia="0.04 0.02 0.02"/>
            <geom name="rod" type="capsule" fromto="0 0 0 0.3 0 0"
                  size="0.012" rgba="0.6 0.6 0.6 0"/>
            <geom name="disk" type="cylinder" pos="0.3 0 0"
                  euler="0 1.5708 0" size="0.08 0.015"
                  rgba="0.85 0.2 0.2 0"/>
        </body>
    </worldbody>
</mujoco>