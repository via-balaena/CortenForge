# CortenForge .gitignore

# =============================================================================
# Rust / Cargo
# =============================================================================
/target/
**/*.rs.bk

# Keep Cargo.lock for reproducible CI builds
# (Recommended for workspaces even if primarily libraries)

# =============================================================================
# IDE / Editor
# =============================================================================
# VS Code
.vscode/
*.code-workspace

# JetBrains (RustRover, IntelliJ)
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.dir-locals.el

# =============================================================================
# OS Generated
# =============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# Build Artifacts
# =============================================================================
*.so
*.dylib
*.dll
*.a
*.lib
*.exe

# =============================================================================
# Coverage & Profiling
# =============================================================================
*.profraw
*.profdata
lcov.info
coverage/
tarpaulin-report.html
cobertura.xml

# =============================================================================
# Documentation
# =============================================================================
# Generated docs (use cargo doc)
/docs/api/

# mdBook output
/docs/book/book/
**/book/

# =============================================================================
# Testing
# =============================================================================
# Proptest regression files (keep these in CI, ignore locally)
# proptest-regressions/

# Fuzzing
/fuzz/artifacts/
/fuzz/corpus/

# =============================================================================
# ML / Data
# =============================================================================
# Model weights (too large for git)
*.onnx
*.pt
*.pth
*.safetensors
*.bin

# Datasets
/data/
*.parquet
*.arrow

# Training outputs
/checkpoints/
/runs/
/logs/
*.artifact.json
*.checkpoint.json

# =============================================================================
# External Tool Logs
# =============================================================================
MUJOCO_LOG.TXT

# =============================================================================
# Project Specific
# =============================================================================
# Temporary files
*.tmp
*.temp

# Local configuration overrides
.env
.env.local
*.local.toml
*.local.json

# Claude Code settings (user-specific)
.claude/

# Benchmark results (regenerate with cargo bench)
/target/criterion/

# =============================================================================
# Scan + mesh binaries — NEVER in this repository
# =============================================================================
# This repo is PUBLIC and some of the casting pipeline's inputs are anatomical
# scans of a real person. They live in ~/scans and are reached via
# CF_CAST_ITER1_DIR (see design/cf-cast/tests/iter1_gate.rs) or regenerated by
# cf-cast; nothing here has ever tracked a mesh.
#
# That was habit rather than a rule until 2026-07-29, when `git add` was observed
# accepting a 29 MB anatomical scan without complaint. Once pushed, such a blob is
# in the public history permanently — so this is a hard rule now, enforced twice:
# here, and by the pre-commit hook in xtask/build.rs, which catches `git add -f`
# (something .gitignore cannot do). Override for a genuinely non-personal fixture
# with CF_ALLOW_MESH=1.
#
# These lines cannot untrack anything: zero meshes are tracked, and .gitignore
# never applies to files already in the index.
*.stl
*.obj
*.ply
*.3mf
*.mtl

# Cast example STL artifacts (regenerate via
# `cargo run -p example-cast-layered-silicone-device-v1`).
# procedure.md is committed as a workshop reference; STLs are large
# binaries with no GitHub-browse value. Redundant with the blanket rule above,
# kept because it documents WHY that particular directory is disposable.
examples/cast/*/out/*.stl

# =============================================================================
# Old Repos (during migration)
# =============================================================================
# These are the original repos being migrated - keep for reference but don't track
# /CortenForge/
# /mesh/
# /lumen-geometry/

# Python bytecode (from the OpenSim asset generators)
__pycache__/
*.pyc

# OpenSim writes this log next to whatever cwd the reference generators run in
opensim.log
**/opensim.log
